<?xml version="1.0" encoding="UTF-8"?>
<extentreports>
    <configuration>
        <theme>STANDARD</theme>
        <encoding>UTF-8</encoding>
        <protocol>HTTPS</protocol>
        <documentTitle>Test Report</documentTitle>
        <reportName>Automation Test Results</reportName>
        <timelineEnabled>true</timelineEnabled>
        <offlineMode>true</offlineMode>
        <thumbnailForBase64>true</thumbnailForBase64>
        <timeStampFormat>MMM dd, yyyy HH:mm:ss</timeStampFormat>
    </configuration>
</extentreports>
