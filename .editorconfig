# This file is for unifying the coding style for different editors and IDEs
# See editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
tab_width = 4
indent_size = tab

[*.{xml,xsd}]
max_line_length = off
tab_width = 4
indent_size = 4
insert_final_newline = false